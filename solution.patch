+package com.Odin.FirstTask;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class UserControllerIntegrationTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Test
+    @DisplayName("POST /api/v1/users - Success: returns 201 Created for valid payload")
+    void createUser_validPayload_returnsCreated() throws Exception {
+        String validJson = """
+                {
+                  "name": "Alice Smith",
+                  "email": "alice.smith@example.com",
+                  "age": 28,
+                  "role": "USER",
+                  "address": {
+                    "street": "100 Market St",
+                    "city": "San Francisco",
+                    "zipCode": "94105"
+                  }
+                }
+                """;
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(validJson))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.id", notNullValue()))
+                .andExpect(jsonPath("$.name", is("Alice Smith")))
+                .andExpect(jsonPath("$.email", is("alice.smith@example.com")))
+                .andExpect(jsonPath("$.age", is(28)))
+                .andExpect(jsonPath("$.role", is("USER")))
+                .andExpect(jsonPath("$.address.city", is("San Francisco")));
+    }
+
+    @Test
+    @DisplayName("POST /api/v1/users - Validation: returns 400 Bad Request when required fields are missing")
+    void createUser_missingFields_returnsBadRequest() throws Exception {
+        String emptyJson = "{}";
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(emptyJson))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.status", is(400)))
+                .andExpect(jsonPath("$.error", is("Bad Request")))
+                .andExpect(jsonPath("$.message", containsString("Validation failed")))
+                .andExpect(jsonPath("$.errors.name", notNullValue()))
+                .andExpect(jsonPath("$.errors.email", notNullValue()))
+                .andExpect(jsonPath("$.errors.age", notNullValue()))
+                .andExpect(jsonPath("$.errors.role", notNullValue()))
+                .andExpect(jsonPath("$.errors.address", notNullValue()));
+    }
+
+    @Test
+    @DisplayName("POST /api/v1/users - Boundary: returns 400 Bad Request when age is below 18")
+    void createUser_boundaryAgeBelow18_returnsBadRequest() throws Exception {
+        String underageJson = """
+                {
+                  "name": "Minor User",
+                  "email": "minor@example.com",
+                  "age": 16,
+                  "role": "USER",
+                  "address": {
+                    "street": "123 Maple St",
+                    "city": "Springfield",
+                    "zipCode": "62701"
+                  }
+                }
+                """;
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(underageJson))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.status", is(400)))
+                .andExpect(jsonPath("$.errors.age", is("Age must be at least 18")));
+    }
+
+    @Test
+    @DisplayName("POST /api/v1/users - Validation: returns 400 Bad Request for invalid email format")
+    void createUser_invalidEmail_returnsBadRequest() throws Exception {
+        String invalidEmailJson = """
+                {
+                  "name": "Bob Vance",
+                  "email": "invalid-email-no-at-sign",
+                  "age": 45,
+                  "role": "USER",
+                  "address": {
+                    "street": "456 Oak Rd",
+                    "city": "Scranton",
+                    "zipCode": "18503"
+                  }
+                }
+                """;
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(invalidEmailJson))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.status", is(400)))
+                .andExpect(jsonPath("$.errors.email", is("Email format is invalid")));
+    }
+
+    @Test
+    @DisplayName("POST /api/v1/users - Nested Validation: returns 400 Bad Request for invalid address zip code")
+    void createUser_invalidZipCode_returnsBadRequest() throws Exception {
+        String invalidZipJson = """
+                {
+                  "name": "Charlie Brown",
+                  "email": "charlie@example.com",
+                  "age": 30,
+                  "role": "USER",
+                  "address": {
+                    "street": "789 Pine Ave",
+                    "city": "Minneapolis",
+                    "zipCode": "ABC"
+                  }
+                }
+                """;
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(invalidZipJson))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.status", is(400)))
+                .andExpect(jsonPath("$.errors['address.zipCode']", is("Zip code must be a 5-digit number")));
+    }
+
+    @Test
+    @DisplayName("POST /api/v1/users - Malformed JSON: returns 400 Bad Request for malformed body")
+    void createUser_malformedJson_returnsBadRequest() throws Exception {
+        String malformedJson = "{ \"name\": \"Malformed\", \"age\": \"not_a_number\" }";
+
+        mockMvc.perform(post("/api/v1/users")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(malformedJson))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.status", is(400)))
+                .andExpect(jsonPath("$.message", containsString("Malformed JSON request payload")));
+    }
+
+    @Test
+    @DisplayName("GET /api/v1/users/{id} - Not Found: returns 404 for nonexistent user ID")
+    void getUserById_notFound_returnsNotFound() throws Exception {
+        mockMvc.perform(get("/api/v1/users/999"))
+                .andExpect(status().isNotFound())
+                .andExpect(jsonPath("$.status", is(404)))
+                .andExpect(jsonPath("$.message", containsString("User not found with id: 999")));
+    }
+}
